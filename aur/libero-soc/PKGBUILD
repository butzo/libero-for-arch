# Maintainer: libero-for-arch contributors

pkgname=libero-soc
pkgver=0.2.0
pkgrel=3
pkgdesc="Installer and Arch integration for Microchip Libero SoC (runs the vendor's installer; no vendor files included)"
arch=(x86_64)
url="https://github.com/butzo/libero-for-arch"
license=(AGPL-3.0-or-later)
depends=(
	# Licence server and setup tool
	libero-flexlm bash coreutils findutils gawk grep sed util-linux unzip less systemd ca-certificates
	python
	xdg-utils xdg-user-dirs
	# The vendor web installer
	libpng15
	# Libero, Synplify, Identify, ModelSim and QuestaSim (findings.md section 4)
	xorg-xwayland libxml2-legacy libxcrypt-compat gtk2 ncurses5-compat-libs
	numactl libtirpc gperftools pciutils
	lib32-glibc lib32-gcc-libs lib32-libx11 lib32-libxext lib32-libxrender lib32-libxft lib32-fontconfig
	glib2 pango cairo fontconfig freetype2 gdk-pixbuf2 at-spi2-core libglvnd
	libx11 libxcb libxext libxrender libxft libxi libxt libxpm libxtst libxss libxrandr libxfixes
	libxdamage libxcomposite libxcursor libxinerama libxxf86vm libxau libice libsm libxslt
	libpulse alsa-lib krb5 nss nspr sqlite expat bzip2 xz
)
checkdepends=(shellcheck zip)
install=libero-soc.install

# Development build: the files are taken from this repository checkout.
# For the AUR this becomes a release tarball in source=().
_src() { printf %s "$startdir/../../soc"; }

check() {
	shellcheck -x "$(_src)/libero-setup" "$(_src)/installer.sh" "$(_src)/libero"
	python3 -I -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$(_src)/qres-extract"
	bash "$startdir/../../tests/libero-setup.test.sh"
	bash "$startdir/../../tests/libero-wrapper.test.sh"
}

package() {
	local src
	src=$(_src)
	install -Dm755 "$src/libero" "$pkgdir/usr/bin/libero"
	install -Dm755 "$src/libero-setup" "$pkgdir/usr/bin/libero-setup"
	install -Dm644 "$src/installer.sh" "$pkgdir/usr/lib/libero-soc/installer.sh"
	install -Dm755 "$src/qres-extract" "$pkgdir/usr/lib/libero-soc/qres-extract"
	# Menu entries are written per installed version by libero-setup, into
	# /usr/local/share/applications, like the vendor installer's own.
	install -Dm644 "$src/70-libero-soc.rules" "$pkgdir/usr/lib/udev/rules.d/70-libero-soc.rules"
	install -Dm644 "$src/tmpfiles.conf" "$pkgdir/usr/lib/tmpfiles.d/libero-soc.conf"
	install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/libero-soc/README.md"
	# Shims for the vendor's RHEL-only scripts (findings.md section 4):
	# the launcher picks its library path from /etc/redhat-release, and the
	# IP catalogue download looks for the CA bundle at the RHEL path.
	install -Dm644 "$src/redhat-release" "$pkgdir/etc/redhat-release"
	install -dm755 "$pkgdir/etc/pki/tls/certs"
	ln -s /etc/ssl/certs/ca-certificates.crt "$pkgdir/etc/pki/tls/certs/ca-bundle.crt"
}
