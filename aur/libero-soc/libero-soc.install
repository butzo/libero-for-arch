post_install() {
	cat <<'EOF'
==> libero-soc: next steps
    1. sudo libero-setup install
         opens Microchip's installer download in your browser (it needs a
         Microchip sign-in), waits for it, shows the licence agreement,
         then installs Libero SoC into /opt/microchip
         (about 15 minutes, 12.5 GB download)
    2. Licence server: on this machine, install libero-flexlm and run
         libero-license hostid, then sudo libero-license install <License.dat>
       For your organisation's server, set LM_LICENSE_FILE,
         SNPSLMD_LICENSE_FILE and SALT_LICENSE_SERVER to <port>@<server>
    Details: /usr/share/doc/libero-soc/README.md
EOF
	libero-setup refresh >/dev/null 2>&1 || true
}

post_upgrade() {
	# Moves the state of older releases to the per-version layout and writes
	# the menu entries of every installed version.
	libero-setup refresh || echo "==> libero-setup refresh failed; run it again by hand"
}

pre_remove() {
	local record
	for record in /var/lib/libero-soc/installs/*/install-dir /var/lib/libero-soc/install-dir; do
		[ -s "$record" ] || continue
		echo "==> Libero SoC is still installed in $(cat "$record")."
		echo "    Remove it first with: sudo libero-setup remove $(basename "$(cat "$record")" | sed 's/^Libero_SoC_//')"
		echo "    Afterwards only by hand: sudo <that directory>/maintenancetool -p minimal -d --confirm-command purge"
	done
}

post_remove() {
	# The generated menu entries start the libero wrapper, which is gone now.
	rm -f /usr/local/share/applications/libero-soc-*.desktop
}
