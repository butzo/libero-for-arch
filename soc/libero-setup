#!/bin/bash
# libero-setup: install, remove and check Microchip Libero SoC on Arch Linux.
# Runs Microchip's own web installer headless; this package ships no vendor
# files. Microchip serves the installer only to a signed-in account, so your
# browser downloads it and libero-setup takes it from there. Several versions
# can be installed side by side.
#
#   libero-setup install [--installer FILE] [--accept-eula]
#                        Without FILE: opens the installer download in your
#                        browser and waits for it in your download folder.
#                        FILE: a downloaded .zip, or the .bin inside it
#                        Takes about 15 minutes. If sudo accepts your
#                        fingerprint, run 'sudo -v' first: otherwise sudo
#                        may end the install 5 minutes after its prompt
#   libero-setup remove VERSION [--purge]
#   libero-setup status
#   libero-setup refresh   recreate menu entries and icons (run by pacman)
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

ROOT=""
# Free space the install needs; 0 switches the check off.
MIN_FREE_GB=50
# The installer this version of the package knows. Microchip serves it only
# to a signed-in account, so the user's browser has to fetch it; the checksum
# makes sure that what is then run as root is this file.
KNOWN_VERSION=2026.1
KNOWN_ZIP=libero_soc_2026.1_online_lin.zip
KNOWN_URL=https://ww1.microchip.com/downloads/secure/aemdocuments/documents/fpga/media-content/fpga/2026.1/90-main/libero_soc_2026.1_online_lin.zip
KNOWN_SHA256=e646ffb9350bab5e2b9b011ee9dcf9a755f0643bf39c3fa4a305dfe1e0b3860e
# Seconds to wait for the browser download.
WAIT_SECONDS=3600
# Seconds between progress lines while the vendor installer runs.
PROGRESS_INTERVAL=15
PROGRESS_PID=""
DOWNLOAD_DIR=""
# Helpers of this package: installer.sh and qres-extract.
LIB_DIR=/usr/lib/libero-soc
# The test suite moves all system paths under a fake root. Outside of it the
# environment is ignored, so that a root run cannot be pointed elsewhere.
if [[ -n ${LIBERO_SETUP_TEST:-} ]]; then
	ROOT=${LIBERO_SETUP_ROOT:-}
	MIN_FREE_GB=${LIBERO_SETUP_MIN_FREE_GB:-$MIN_FREE_GB}
	KNOWN_SHA256=${LIBERO_SETUP_KNOWN_SHA256:-$KNOWN_SHA256}
	WAIT_SECONDS=${LIBERO_SETUP_WAIT:-$WAIT_SECONDS}
	PROGRESS_INTERVAL=${LIBERO_SETUP_PROGRESS_INTERVAL:-$PROGRESS_INTERVAL}
	DOWNLOAD_DIR=${LIBERO_SETUP_DOWNLOAD_DIR:-}
	LIB_DIR=${LIBERO_SETUP_LIB:-$LIB_DIR}
fi
QRES=$LIB_DIR/qres-extract

OPT_DIR=$ROOT/opt/microchip
COMMON_DIR=$OPT_DIR/common
STATE_DIR=$ROOT/var/lib/libero-soc
INSTALLS_DIR=$STATE_DIR/installs
CACHE_DIR=$ROOT/var/cache/libero-soc
LOG_DIR=$ROOT/var/log/libero-soc
DESKTOP_DIR=$ROOT/usr/local/share/applications
FLEXLM_DIR=$ROOT/var/lib/libero-flexlm
REDHAT_RELEASE=$ROOT/etc/redhat-release
CA_BUNDLE=$ROOT/etc/pki/tls/certs/ca-bundle.crt
CYUSB_CONF=$ROOT/etc/cyusb.conf
VENDOR_UDEV_RULE=$ROOT/etc/udev/rules.d/88-cyusb.rules

DOWNLOAD_URL=https://www.microchip.com/Libero
COMPONENT=Libero_SoC
EULA_RESOURCE=/license/license_libero.txt
# The menu entries Microchip's installer creates for each version:
# id | name | launcher below Libero_SoC/ | icon in the installer's
# /libero-icons/. The libero wrapper knows the same ids.
TOOLS=(
	"libero|Libero SoC|Designer/bin/libero|libero.xpm"
	"mss|PFSoC MSS Configurator|Designer/bin64/pfsoc_mss|mss.xpm"
	"program-debug|Program Debug|Designer/bin/sdebug|smart_debug.xpm"
	"fpexpress|FPExpress|Designer/bin/FPExpress|fpexpress.xpm"
)
# The FlashPro6 entry that the vendor's fp6_env_install adds to cyusb.conf.
FP6_LINE='1514 2009'

# A sudo fingerprint module that prompts for the password at the same time
# (pam_fprintd_grosshack) leaves sudo's 5-minute prompt timer running when the
# finger wins; sudo then ends the command as timed out. Credentials cached by
# 'sudo -v' skip the prompt. See docs/findings.md.
SUDO_TIMEOUT_HINT="    If this stops with 'terminated' after about 5 minutes: run 'sudo -v',
    then this command again within 5 minutes."

MOVED_REDHAT=""
TMP_FILES=()

die() {
	echo "libero-setup: $*" >&2
	exit 1
}

warn() { echo "libero-setup: warning: $*" >&2; }

info() { echo "==> $*"; }

on_exit() {
	stop_progress
	restore_redhat_release
	((${#TMP_FILES[@]} == 0)) || rm -rf -- "${TMP_FILES[@]}"
}
trap on_exit EXIT

need_root() {
	[[ $(id -u) -eq 0 || -n ${LIBERO_SETUP_TEST:-} ]] || die "this command needs root; run it with sudo"
}

usage() {
	sed -n '2,/^set -euo/{/^set -euo/d;/^# shellcheck/d;s/^# \{0,1\}//;p}' "$0"
}

# The default repository is named in the installer; using it directly avoids
# a 40-second timeout on a vendor-internal host.
repository_url() {
	{ grep -a -o -m1 -E '<Url>https?://ww1\.microchip\.com/[^<]*</Url>' "$1" || true; } |
		sed -e 's|^<Url>||' -e 's|</Url>$||'
}

# --- installed versions -------------------------------------------------------

installed_versions() {
	local record
	for record in "$INSTALLS_DIR"/*/install-dir; do
		[[ -f $record ]] && basename "$(dirname "$record")"
	done | sort -V
}

install_dir_of() { cat "$INSTALLS_DIR/$1/install-dir"; }

is_installed() { [[ -f $INSTALLS_DIR/$1/install-dir ]]; }

# Releases before 0.2 kept a single install in $STATE_DIR directly.
migrate_state() {
	local legacy=$STATE_DIR/install-dir dir version dest file
	[[ -f $legacy ]] || return 0
	dir=$(cat "$legacy")
	version=$(basename "$dir")
	version=${version#Libero_SoC_}
	if [[ ! $version =~ ^[0-9][0-9.]*[0-9]$ ]]; then
		warn "cannot tell the version of $dir; left $legacy as it is"
		return 0
	fi
	dest=$INSTALLS_DIR/$version
	mkdir -p "$dest"
	for file in install-dir EULA.txt eula-accepted libero.xpm; do
		[[ ! -e $STATE_DIR/$file ]] || mv -f -- "$STATE_DIR/$file" "$dest/$file"
	done
	info "Moved the record of Libero $version to $dest"
}

# --- menu entries ---------------------------------------------------------------

# extract_icons <installer> <dir>: the vendor's icons, read by resource name.
extract_icons() {
	local bin=$1 dest=$2 tool id name icon missing=""
	for tool in "${TOOLS[@]}"; do
		IFS='|' read -r id name _ icon <<<"$tool"
		if "$QRES" get "$bin" "/libero-icons/$icon" "$dest/$icon.part" 2>/dev/null; then
			chmod 0644 "$dest/$icon.part"
			mv -f -- "$dest/$icon.part" "$dest/$icon"
		else
			rm -f -- "$dest/$icon.part"
			missing="$missing $icon"
		fi
	done
	[[ -z $missing ]] || warn "icons not found in the installer:$missing; those menu entries have no icon"
}

update_menu() {
	if command -v update-desktop-database >/dev/null; then
		update-desktop-database -q "$DESKTOP_DIR" 2>/dev/null || true
	fi
}

# write_entries <version>: one entry per tool, named like Microchip's.
write_entries() {
	local version=$1 dest=$INSTALLS_DIR/$1 tool id name icon file
	mkdir -p "$DESKTOP_DIR"
	for tool in "${TOOLS[@]}"; do
		IFS='|' read -r id name _ icon <<<"$tool"
		file=$DESKTOP_DIR/libero-soc-$version-$id.desktop
		{
			echo "[Desktop Entry]"
			echo "Type=Application"
			echo "Name=$name $version"
			echo "Comment=Microchip $name $version"
			[[ ! -s $dest/$icon ]] || echo "Icon=${dest#"$ROOT"}/$icon"
			if [[ $id == libero ]]; then
				echo "GenericName=FPGA Design Suite"
				echo "Exec=libero --version $version %f"
				echo "StartupWMClass=libero_bin"
			else
				echo "Exec=libero --version $version --tool $id"
			fi
			echo "Terminal=false"
			echo "Categories=Development;Electronics;"
		} >"$file.part"
		chmod 0644 "$file.part"
		mv -f -- "$file.part" "$file"
	done
}

remove_entries() {
	rm -f -- "$DESKTOP_DIR"/libero-soc-"$1"-*.desktop
}

# --- the installer file --------------------------------------------------------

# find_installer, prepare_installer, version_of, sha256_of and the browser
# hand-off live in installer.sh; cmd_install loads it once it runs as root.
load_installer_helpers() {
	[[ -r $LIB_DIR/installer.sh ]] || die "$LIB_DIR/installer.sh is missing; reinstall the libero-soc package"
	# shellcheck source=installer.sh
	. "$LIB_DIR/installer.sh"
}

# --- checks -------------------------------------------------------------------

existing_ancestor() {
	local dir=$1
	until [[ -d $dir ]]; do dir=$(dirname "$dir"); done
	echo "$dir"
}

# Free space in MiB; df -BG would round up.
free_mb() { df -BM --output=avail "$(existing_ancestor "$1")" | tail -n 1 | tr -dc '0-9'; }

check_space() {
	((MIN_FREE_GB > 0)) || return 0
	local opt cache
	opt=$(free_mb "$OPT_DIR")
	cache=$(free_mb "$CACHE_DIR")
	if [[ $(stat -c %d "$(existing_ancestor "$OPT_DIR")") == $(stat -c %d "$(existing_ancestor "$CACHE_DIR")") ]]; then
		((opt >= MIN_FREE_GB * 1024)) ||
			die "not enough free space: the install needs about ${MIN_FREE_GB} GB (34 GB installed, 12.5 GB download); free: $((opt / 1024)) GB"
	else
		((opt >= 36 * 1024 && cache >= 13 * 1024)) ||
			die "not enough free space: 36 GB needed for /opt (free: $((opt / 1024)) GB) and 13 GB for /var/cache (free: $((cache / 1024)) GB)"
	fi
}

# --- licence agreement --------------------------------------------------------

# This runs as root: secure mode stops less from starting a shell or editor.
show_text() {
	if command -v less >/dev/null; then
		LESSSECURE=1 less -- "$1"
	else
		cat -- "$1"
	fi
}

# consent <installer> <accept flag> <state dir>: show the agreement and
# record consent.
consent() {
	local bin=$1 accepted=$2 dest=$3 text found=no answer how
	mkdir -p "$dest"
	text=$(mktemp "$dest/EULA.XXXXXX")
	TMP_FILES+=("$text")
	if "$QRES" get "$bin" "$EULA_RESOURCE" "$text" 2>/dev/null && grep -q -i 'LIBERO SOC' "$text"; then
		found=yes
	fi

	if [[ -n $accepted ]]; then
		how="--accept-eula"
	else
		[[ -t 0 ]] || die "the Microchip licence agreement has to be accepted. Run this in a terminal,
or pass --accept-eula if you have read and accept it."
		if [[ $found == yes ]]; then
			echo "Installing Libero SoC requires accepting Microchip's licence agreement."
			read -r -p "Press Enter to read it; you are asked to accept it afterwards. " _ ||
				die "aborted; nothing was installed"
			show_text "$text"
		else
			echo "The licence agreement could not be read from this installer."
			echo "Read it in the graphical installer ($bin) or on $DOWNLOAD_URL"
		fi
		read -r -p 'Type "I accept" to accept the agreement, anything else to stop: ' answer ||
			die "aborted; nothing was installed"
		[[ $answer == "I accept" ]] || die "agreement not accepted; nothing was installed"
		how="interactive prompt"
	fi

	{
		echo "accepted on: $(date -Iseconds)"
		echo "accepted by: ${SUDO_USER:-$(id -un)}"
		echo "how: $how"
		if [[ $found == yes ]]; then
			echo "revision: $(grep -m1 -o -E 'License Rev\. No\. [0-9-]+' "$text" || echo unknown)"
			echo "text: ${dest#"$ROOT"}/EULA.txt"
			echo "text sha256: $(sha256_of "$text")"
		else
			echo "text: not found in the installer"
		fi
		echo "installer: $(basename "$bin") sha256 $(sha256_of "$bin")"
	} >"$dest/eula-accepted"
	if [[ $found == yes ]]; then
		chmod 0644 "$text"
		mv -f -- "$text" "$dest/EULA.txt"
	fi
}

# --- shims and vendor leftovers ------------------------------------------------

# With /etc/redhat-release present, the vendor's requirements check takes the
# system for RHEL and runs yum as root. Keep it out of the way while the
# vendor installer runs.
move_redhat_release_aside() {
	[[ -e $REDHAT_RELEASE ]] || return 0
	MOVED_REDHAT=$REDHAT_RELEASE.libero-setup
	mv -f -- "$REDHAT_RELEASE" "$MOVED_REDHAT"
}

restore_redhat_release() {
	[[ -n $MOVED_REDHAT ]] || return 0
	[[ ! -e $MOVED_REDHAT ]] || mv -f -- "$MOVED_REDHAT" "$REDHAT_RELEASE"
	MOVED_REDHAT=""
}

# A run that was killed outright cannot restore the file; do it next time.
recover_redhat_release() {
	local aside=$REDHAT_RELEASE.libero-setup
	[[ -e $aside ]] || return 0
	if [[ -e $REDHAT_RELEASE ]]; then
		rm -f -- "$aside"
	else
		mv -f -- "$aside" "$REDHAT_RELEASE"
		warn "restored $REDHAT_RELEASE, left aside by an aborted run"
	fi
}

# The vendor rule makes every Microchip USB device writable by everyone and
# resets the tag list; the package's own rule grants the seat user access.
remove_vendor_udev_rule() {
	[[ -f $VENDOR_UDEV_RULE ]] || return 0
	if grep -q 'cyusb_dev' "$VENDOR_UDEV_RULE" && grep -q '1514' "$VENDOR_UDEV_RULE"; then
		rm -f -- "$VENDOR_UDEV_RULE"
	fi
}

# Drop the FlashPro6 entry; drop the file when nothing else is listed.
clean_cyusb_conf() {
	[[ -f $CYUSB_CONF ]] || return 0
	local others
	# Anything besides the vendor's own lines means the file is shared.
	others=$(grep -v -E '^[[:space:]]*$|^[[:space:]]*</?VPD>[[:space:]]*$|^(LogFile|PIDFile)=' "$CYUSB_CONF" |
		grep -v -F "$FP6_LINE" || true)
	if [[ -z $others ]]; then
		rm -f -- "$CYUSB_CONF"
	else
		sed -i "/^[[:space:]]*${FP6_LINE}[[:space:]]/d" "$CYUSB_CONF"
	fi
}

# Logs can contain paths and the user name; keep them from other users.
make_log_dir() {
	mkdir -p "$LOG_DIR"
	chmod 0750 "$LOG_DIR"
}

reload_udev() {
	command -v udevadm >/dev/null || return 0
	udevadm control --reload-rules || warn "udevadm control failed"
	udevadm trigger --subsystem-match=usb --attr-match=idVendor=1514 || true
}

# repoint_licence <removed dir>: the libero-flexlm service runs the daemons
# of one install; move it to the newest remaining one if it used this one.
repoint_licence() {
	local removed=$1 link=$FLEXLM_DIR/daemons target
	[[ -L $link ]] || return 0
	target=$(readlink -- "$link")
	[[ $target == "$removed" || $target == "$removed"/* ]] || return 0
	if [[ -n $(installed_versions) && -r $FLEXLM_DIR/License.dat ]] && command -v libero-license >/dev/null; then
		info "The licence server used the daemons of the removed version; moving it to the newest remaining one"
		libero-license install "${FLEXLM_DIR#"$ROOT"}/License.dat" || warn "libero-license install failed; run it by hand"
	else
		warn "the licence server used the daemons of $removed. It stops working until a Libero
version is installed again and 'sudo libero-license install <License.dat>' is run."
	fi
}

# --- progress -----------------------------------------------------------------

# The vendor installer is silent for minutes while it downloads and unpacks.
# Its log names both totals; the work itself shows as growing directories.

# size_gb <dir...>: their combined size in GB, one decimal.
size_gb() {
	{ du -sb -- "$@" 2>/dev/null || true; } | awk '{ sum += $1 } END { printf "%.1f", sum / 1e9 }'
}

# logged_total <log> <label>: the size the installer announced, e.g. "33.76 GB".
logged_total() {
	sed -n "s/.*$2: \"\\([0-9.]* GB\\)\".*/\\1/p" "$1" 2>/dev/null | head -n 1
}

# show_progress <target> <log>: runs until stopped.
show_progress() {
	local target=$1 log=$2 total last="" line
	while sleep "$PROGRESS_INTERVAL"; do
		if grep -q -E 'Installing component|Installation finished' "$log" 2>/dev/null; then
			line="    finishing ..."
		elif grep -q 'Preparing to unpack' "$log" 2>/dev/null; then
			total=$(logged_total "$log" 'Installation space required')
			line="    unpacked   $(size_gb "$target") of ${total:-about 34 GB}"
		elif grep -q 'Downloading archive' "$log" 2>/dev/null; then
			total=$(logged_total "$log" 'Temporary space required')
			line="    downloaded $(size_gb "$CACHE_DIR/tmp" "$CACHE_DIR/ifw") of ${total:-about 12 GB}"
		else
			line="    preparing ..."
		fi
		[[ $line == "$last" ]] || echo "$line"
		last=$line
	done
}

stop_progress() {
	[[ -n $PROGRESS_PID ]] || return 0
	kill "$PROGRESS_PID" 2>/dev/null || true
	wait "$PROGRESS_PID" 2>/dev/null || true
	PROGRESS_PID=""
}

# --- commands -----------------------------------------------------------------

run_vendor_installer() {
	local bin=$1 target=$2 log=$3 repo status
	local -a args
	repo=$(repository_url "$bin")
	args=(-p minimal -d --root "$target" --cache-path "$CACHE_DIR/ifw")
	[[ -z $repo ]] || args+=(--set-temp-repository "$repo")
	args+=(--no-default-installations --accept-licenses --accept-messages --confirm-command
		install "$COMPONENT" "CommonDir=$COMMON_DIR" LINUX_NO_SHORTCUTS=true)
	mkdir -p "$CACHE_DIR/tmp"
	make_log_dir
	info "Running the vendor installer: about 15 minutes, 12.5 GB download. Log: $log"
	[[ -z ${SUDO_USER:-} ]] || echo "$SUDO_TIMEOUT_HINT"
	: >"$log"
	show_progress "$target" "$log" &
	PROGRESS_PID=$!
	set +e
	TMPDIR=$CACHE_DIR/tmp "$bin" "${args[@]}" 2>&1 | tee "$log" |
		grep --line-buffered -E 'Downloading archive|Unpacking components|Installing component|installed successfully|[Ee]rror'
	status=${PIPESTATUS[0]}
	set -e
	stop_progress
	return "$status"
}

cmd_install() {
	local given="" accepted="" source bin version target log status dest hint
	while (($#)); do
		case $1 in
		--installer)
			(($# >= 2)) || die "--installer needs a file"
			given=$2
			shift 2
			;;
		--accept-eula)
			accepted=1
			shift
			;;
		*) die "unknown option $1; see libero-setup --help" ;;
		esac
	done
	need_root
	load_installer_helpers
	recover_redhat_release
	migrate_state

	source=$(find_installer "$given")
	bin=$(prepare_installer "$source")
	version=$(version_of "$bin")
	! is_installed "$version" ||
		die "Libero $version is already installed in $(install_dir_of "$version"); run 'libero-setup remove $version' first"
	target=$OPT_DIR/Libero_SoC_$version
	if [[ -e $target && -n $(ls -A "$target" 2>/dev/null) ]]; then
		# Never delete it here: it may be an install made by hand.
		hint="sudo rm -rf $target"
		[[ ! -x $target/maintenancetool ]] || hint="sudo $target/maintenancetool -p minimal -d --confirm-command purge"
		die "$target exists and is not empty; the vendor installer needs an empty target.
If it is an old or failed install, remove it with:
  $hint
then run this again."
	fi
	check_space

	dest=$INSTALLS_DIR/$version
	consent "$bin" "$accepted" "$dest"

	log=$LOG_DIR/install-$(date +%Y%m%d-%H%M%S).log
	move_redhat_release_aside
	status=0
	run_vendor_installer "$bin" "$target" "$log" || status=$?
	restore_redhat_release
	# Also after a failure: the vendor rule makes the programmers world-writable.
	remove_vendor_udev_rule
	reload_udev
	if ((status != 0)) || ! grep -q 'Components installed successfully' "$log" ||
		[[ ! -x $target/Libero_SoC/Designer/bin/libero ]]; then
		die "the vendor installer failed (exit $status). Details: $log"
	fi

	extract_icons "$bin" "$dest"
	echo "$target" >"$dest/install-dir"
	write_entries "$version"
	update_menu

	info "Libero SoC $version installed in $target"
	if [[ -L $FLEXLM_DIR/daemons ]]; then
		echo "The licence server keeps using $(readlink -- "$FLEXLM_DIR/daemons")."
		echo "To use the daemons of the newest version: sudo libero-license install /var/lib/libero-flexlm/License.dat"
	else
		cat <<EOF
Next:
  1. libero-license hostid            host ID for the free Silver licence
  2. sudo libero-license install <License.dat>
  3. Start Libero from the menu or with: libero
EOF
	fi
}

cmd_remove() {
	local purge="" version="" dir log status=0
	local -a versions
	while (($#)); do
		case $1 in
		--purge)
			purge=1
			shift
			;;
		-*) die "unknown option $1; see libero-setup --help" ;;
		*)
			[[ -z $version ]] || die "name one version to remove"
			version=$1
			shift
			;;
		esac
	done
	need_root
	recover_redhat_release
	migrate_state
	mapfile -t versions < <(installed_versions)
	((${#versions[@]})) || die "nothing installed by libero-setup"
	if [[ -z $version ]]; then
		{
			echo "libero-setup: name the version to remove. Installed:"
			for version in "${versions[@]}"; do
				echo "  $version in $(install_dir_of "$version")"
				echo "      sudo libero-setup remove $version"
			done
			echo "Add --purge to remove the agreement record and the cached installer as well."
		} >&2
		exit 1
	fi
	is_installed "$version" || die "Libero $version is not installed by libero-setup (installed: ${versions[*]})"
	dir=$(install_dir_of "$version")

	if [[ ! -e $dir ]]; then
		warn "$dir no longer exists; cleaning up the rest"
	else
		[[ -x $dir/maintenancetool ]] || die "$dir has no maintenancetool, so the vendor uninstaller cannot run.
Delete the directory with:
  sudo rm -rf $dir
then run 'sudo libero-setup remove $version' again to clean up the rest."
		make_log_dir
		log=$LOG_DIR/remove-$(date +%Y%m%d-%H%M%S).log
		info "Running the vendor uninstaller. Log: $log"
		"$dir/maintenancetool" -p minimal -d --confirm-command purge >"$log" 2>&1 || status=$?
		[[ ! -e $dir ]] || die "the vendor uninstaller left $dir behind (exit $status). Details: $log"
	fi

	remove_entries "$version"
	update_menu
	if [[ -n $purge ]]; then
		rm -rf -- "${INSTALLS_DIR:?}/$version"
		rm -f -- "$CACHE_DIR/installer/Libero_SoC_${version}_online_lin.bin"
	else
		# The record of the accepted agreement stays.
		rm -f -- "$INSTALLS_DIR/$version/install-dir" "$INSTALLS_DIR/$version"/*.xpm
	fi
	remove_vendor_udev_rule
	repoint_licence "$dir"
	info "Libero SoC $version removed from $dir"

	if [[ -z $(installed_versions) ]]; then
		rmdir -- "$COMMON_DIR" 2>/dev/null || true
		rmdir -- "$OPT_DIR" 2>/dev/null || true
		clean_cyusb_conf
		if [[ -n $purge ]]; then
			rm -rf -- "$CACHE_DIR/installer" "$CACHE_DIR/ifw" "$CACHE_DIR/tmp" "$LOG_DIR"
			cat <<'EOF'
Per-user data is left in each user's home directory; remove it by hand:
  ~/.actel             settings and the per-user IP vault (~/.actel/vault)
  ~/.config/Actel      tool settings
  ~/.config/Microsemi  I/O Editor settings
  ~/.modelsim          ModelSim window settings
EOF
		fi
	fi
	reload_udev
}

# refresh: bring the state and the menu entries up to date with what is
# installed. pacman runs it after installing or upgrading the package.
cmd_refresh() {
	local version bin dest file
	need_root
	recover_redhat_release
	migrate_state
	for version in $(installed_versions); do
		dest=$INSTALLS_DIR/$version
		bin=$CACHE_DIR/installer/Libero_SoC_${version}_online_lin.bin
		if [[ -f $bin ]]; then
			extract_icons "$bin" "$dest"
		else
			warn "no cached installer for $version; its menu entries keep the icons they have"
		fi
		write_entries "$version"
	done
	# Entries of versions that are no longer installed.
	for file in "$DESKTOP_DIR"/libero-soc-*.desktop; do
		[[ -f $file ]] || continue
		version=${file##*/libero-soc-}
		version=${version%%-*}
		is_installed "$version" || rm -f -- "$file"
	done
	update_menu
}

cmd_status() {
	local version dir newest healthy=0 icons entries
	local -a versions
	mapfile -t versions < <(installed_versions)
	if [[ -f $STATE_DIR/install-dir ]]; then
		echo "state:     old layout; run 'sudo libero-setup refresh'"
		healthy=1
	fi
	if ((${#versions[@]} == 0)); then
		echo "Libero:    not installed (sudo libero-setup install)"
		return 1
	fi
	newest=${versions[-1]}
	for version in "${versions[@]}"; do
		dir=$(install_dir_of "$version")
		echo "Libero:    $version in $dir$([[ $version != "$newest" ]] || echo " (default)")"
		if [[ ! -x $dir/Libero_SoC/Designer/bin/libero ]]; then
			echo "           launcher MISSING ($dir/Libero_SoC/Designer/bin/libero)"
			healthy=1
		fi
		icons=$(find "$INSTALLS_DIR/$version" -maxdepth 1 -name '*.xpm' 2>/dev/null | wc -l)
		entries=$(find "$DESKTOP_DIR" -maxdepth 1 -name "libero-soc-$version-*.desktop" 2>/dev/null | wc -l)
		echo "           menu: $entries entries, $icons icons"
		if [[ -f $INSTALLS_DIR/$version/eula-accepted ]]; then
			echo "           agreement: $(sed -n 's/^revision: //p' "$INSTALLS_DIR/$version/eula-accepted"), accepted $(sed -n 's/^accepted on: //p' "$INSTALLS_DIR/$version/eula-accepted")"
		fi
	done
	if grep -q 'AlmaLinux release 9' "$REDHAT_RELEASE" 2>/dev/null; then
		echo "shim:      $REDHAT_RELEASE in place"
	else
		echo "shim:      $REDHAT_RELEASE MISSING or changed; reinstall the libero-soc package"
		healthy=1
	fi
	if [[ -e $CA_BUNDLE ]]; then
		echo "shim:      $CA_BUNDLE in place"
	else
		echo "shim:      $CA_BUNDLE MISSING; reinstall the libero-soc package"
		healthy=1
	fi
	if [[ -f $VENDOR_UDEV_RULE ]] && grep -q 'cyusb_dev' "$VENDOR_UDEV_RULE"; then
		echo "udev:      vendor rule $VENDOR_UDEV_RULE makes Microchip USB devices world-writable; delete it"
	fi
	echo "IP cores:  downloaded per user into ~/.actel/vault"
	echo "licence:   see 'sudo libero-license status'"
	return "$healthy"
}

main() {
	local command=${1:-}
	[[ $# -eq 0 ]] || shift
	case $command in
	install) cmd_install "$@" ;;
	remove) cmd_remove "$@" ;;
	status) cmd_status ;;
	refresh) cmd_refresh ;;
	-h | --help | help) usage ;;
	"")
		usage >&2
		exit 1
		;;
	*) die "unknown command '$command'; see libero-setup --help" ;;
	esac
}

main "$@"
